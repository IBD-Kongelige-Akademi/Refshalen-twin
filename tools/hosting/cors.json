{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://YOUR-GITHUB-USERNAME.github.io",
          "http://localhost:8000",
          "http://127.0.0.1:8000",
          "http://localhost:8010",
          "http://127.0.0.1:8010",
          "http://localhost:8011",
          "http://127.0.0.1:8011"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["Content-Length", "Content-Type", "ETag", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
