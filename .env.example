# Copy to .env (gitignored) and fill in. Read by tools/cph-geodata/envsecret.py; a variable already set in the environment wins.

# dataforsyningen.dk user account -> token: orthophotos, CIR, Skråfoto, DHM terrain (WCS)
GSEARCH_TOKEN=
DHM_TERRAIN_TOKEN=

# datafordeler.dk self-service API key: DHM point cloud (vegetation)
DATAFORDELER_GRAPHQL_API_KEY=

# Datafordeler service user: only the DAGI and DAR fetchers still use it, until datagrundlag.dk replaces them (phases 2 and 5)
DATAFORDELER_USERNAME=
DATAFORDELER_PASSWORD=
